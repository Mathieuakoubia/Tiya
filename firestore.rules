rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    // Vérifie que l'utilisateur connecté est membre du squad donné
    function isSquadMember(squadId) {
      return isAuth()
          && request.auth.uid in get(/databases/$(database)/documents/squads/$(squadId)).data.users;
    }

    // ═══════════════════════════════════════════════════════════════
    // UTILISATEURS
    // ═══════════════════════════════════════════════════════════════
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isUser(uid);
      allow update: if isUser(uid);
      allow delete: if false;

      match /selfie/{document} {
        allow read: if isAuth();
        allow create, write, delete: if isUser(uid);
      }

      // Notes utilisateur — Gratitude Flash & Savoring Moment
      match /user_notes/{noteId} {
        allow read, write: if isUser(uid);

        match /entries/{entryId} {
          allow read, write: if isUser(uid);
        }
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // TWIN INVITATION
    // ═══════════════════════════════════════════════════════════════
    match /twinInvitation/{docId} {
      allow read: if isAuth() && request.auth.uid in resource.data.users;

      allow create: if isAuth()
          && request.auth.uid == request.resource.data.fromUid
          && request.auth.uid in request.resource.data.users
          && request.resource.data.users.size() == 2
          && request.resource.data.status == 'pending';

      allow update: if isAuth()
          && request.auth.uid in resource.data.users
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SQUADS
    // ═══════════════════════════════════════════════════════════════
    match /squads/{squadId} {
      allow read: if isAuth() && request.auth.uid in resource.data.users;

      allow create: if isAuth()
          && request.auth.uid == request.resource.data.createdBy
          && request.auth.uid in request.resource.data.users
          && request.resource.data.users.size() == 1;

      allow update: if isAuth() && (
          request.auth.uid in resource.data.users
          ||
          (!(request.auth.uid in resource.data.users)
           && request.auth.uid in request.resource.data.users
           && request.resource.data.users.size() == resource.data.users.size() + 1
           && request.resource.data.users.size() <= 5
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users']))
      );

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // INVITATIONS SQUAD
    // ═══════════════════════════════════════════════════════════════
    match /squad_invitations/{inviteId} {
      allow read: if isAuth()
          && (request.auth.uid == resource.data.toUid
           || request.auth.uid == resource.data.fromUid);

      // L'expéditeur doit être membre du squad qu'il invite à rejoindre
      allow create: if isAuth()
          && request.auth.uid == request.resource.data.fromUid
          && request.resource.data.status == 'pending'
          && isSquadMember(request.resource.data.squadId);

      allow update: if isAuth()
          && request.auth.uid == resource.data.toUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SESSIONS DE ROUTINES SQUAD
    // ═══════════════════════════════════════════════════════════════
    match /squad_sessions/{sessionId} {
      allow read: if isAuth()
          && isSquadMember(resource.data.squadId);

      // L'initiateur doit être membre du squad ciblé
      allow create: if isAuth()
          && request.auth.uid == request.resource.data.launchedBy
          && isSquadMember(request.resource.data.squadId);

      allow update: if isAuth()
          && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['acceptedBy', 'status']);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // INVITATIONS DE ROUTINE (lien partageable avec code)
    // ═══════════════════════════════════════════════════════════════
    match /routine_invitations/{code} {
      allow read: if isAuth();

      allow create: if isAuth()
          && request.auth.uid == request.resource.data.createdBy
          && request.resource.data.status == 'pending';

      allow update: if isAuth()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'used'
          && request.auth.uid == request.resource.data.usedBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy']);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SESSIONS DE ROUTINE TWIN
    // ═══════════════════════════════════════════════════════════════
    match /twin_sessions/{sessionId} {
      allow read: if isAuth() && request.auth.uid in resource.data.users;

      allow create: if isAuth()
          && request.auth.uid == request.resource.data.launchedBy
          && request.auth.uid in request.resource.data.users
          && request.resource.data.users.size() == 2;

      allow update: if isAuth()
          && request.auth.uid in resource.data.users
          && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['acceptedBy', 'status']);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SQUAD (ancien système FlutterFlow — lecture seule en prod)
    // ═══════════════════════════════════════════════════════════════
    match /Squad/{squadId} {
      allow read: if isAuth();
      allow create, write, delete: if false;

      match /members/{userId} {
        allow read: if isAuth();
        allow write: if isUser(userId);
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // TWIN SIGNALS
    // ═══════════════════════════════════════════════════════════════
    match /twin_signals/{uid} {
      allow read: if isAuth();
      allow create, update: if isUser(uid);
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // PROFIL TWIN
    // ═══════════════════════════════════════════════════════════════
    match /profil_twin/{document} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.uid;
      allow update: if isAuth() && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // ROUTINES & TÂCHES
    // ═══════════════════════════════════════════════════════════════
    match /routine/{document} {
      allow read: if isAuth();
      allow create: if request.resource.data.user_ref_path
          == /databases/$(database)/documents/users/$(request.auth.uid);
      allow update, delete: if resource.data.user_ref_path
          == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /routine/{parent}/taches/{document} {
      allow read: if isAuth();
      allow create, write, delete: if isAuth();
    }

    match /{path=**}/taches/{document} {
      allow read: if isAuth();
    }

    // ═══════════════════════════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════════════════════════
    match /Notification/{document} {
      allow read: if isAuth() && request.auth.uid == resource.data.uid;
      allow create: if isAuth();
      allow update: if isAuth() && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // CALENDRIER (FlutterFlow)
    // ═══════════════════════════════════════════════════════════════
    match /calendar_events/{document} {
      allow read, create, update: if isAuth();
      allow delete: if false;
    }

    match /calendar_connections_events/{document} {
      allow read, create, update: if isAuth();
      allow delete: if false;
    }

    match /calendar_connections/{document} {
      allow read, create, update: if isAuth();
      allow delete: if false;
    }

    match /CalendarEvents/{document} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // HUME / GUARDIAN / ACTUALITÉ
    // ═══════════════════════════════════════════════════════════════
    match /hume_jobs/{document} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }

    match /GuardianActions/{document} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }

    match /guardian_suggestions/{document} {
      allow read, create: if isAuth();
      allow update, delete: if false;
    }

    match /Actualite/{document} {
      allow read: if isAuth();
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // CHALLENGES
    // ═══════════════════════════════════════════════════════════════
    match /challenge/{document} {
      allow create: if isAuth()
          && /databases/$(database)/documents/users/$(request.auth.uid)
             in request.resource.data.user;
      allow read: if isAuth()
          && /databases/$(database)/documents/users/$(request.auth.uid)
             in resource.data.user;
      allow update, delete: if isAuth()
          && /databases/$(database)/documents/users/$(request.auth.uid)
             in resource.data.user;
    }

    // ═══════════════════════════════════════════════════════════════
    // INTENTIONS SQUAD — Intention Wheel (routine 12)
    // Doc ID = {squadId}_{userUid}_{date}
    // ═══════════════════════════════════════════════════════════════
    match /squad_intentions/{docId} {
      // Lecture : membres du squad concerné uniquement
      allow read: if isAuth()
          && isSquadMember(resource.data.squadId);

      // Écriture : auteur = utilisateur connecté ET membre du squad ciblé
      allow create, update: if isAuth()
          && request.auth.uid == request.resource.data.userUid
          && isSquadMember(request.resource.data.squadId);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // JARDIN GRATITUDE SQUAD — Squad-Gratitude-Garden (routine 51)
    // ═══════════════════════════════════════════════════════════════
    match /squad_gratitude/{docId} {
      // Lecture : membres du squad concerné uniquement
      allow read: if isAuth()
          && isSquadMember(resource.data.squadId);

      // Écriture : auteur = utilisateur connecté ET membre du squad ciblé
      allow create: if isAuth()
          && request.auth.uid == request.resource.data.authorUid
          && isSquadMember(request.resource.data.squadId);

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SIGNALS SQUAD — Squad-Morning-Pulse (routine 50)
    // ═══════════════════════════════════════════════════════════════
    match /squad_signals/{docId} {
      // Lecture : destinataire uniquement
      allow read: if isAuth()
          && request.auth.uid == resource.data.toUid;

      // Écriture : expéditeur = utilisateur connecté ET membre du squad ciblé
      allow create: if isAuth()
          && request.auth.uid == request.resource.data.fromUid
          && isSquadMember(request.resource.data.squadId);

      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // CAPSULES TWIN — Savoring-Duo (routine 47)
    // ═══════════════════════════════════════════════════════════════
    match /twin_capsules/{docId} {
      allow read: if isAuth() && request.auth.uid in resource.data.users;
      allow create: if isAuth() && request.auth.uid in request.resource.data.users;
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // CAPSULES AUDIO — Audio-Capsule (routine 13)
    // ═══════════════════════════════════════════════════════════════
    match /audio_capsules/{docId} {
      allow read: if isAuth()
          && (request.auth.uid == resource.data.fromUid
           || request.auth.uid == resource.data.toUid);

      allow create: if isAuth()
          && request.auth.uid == request.resource.data.fromUid;

      // Le destinataire peut uniquement marquer la capsule comme ouverte
      allow update: if isAuth()
          && request.auth.uid == resource.data.toUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opened', 'openedAt']);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // REFUS PAR DÉFAUT — tout ce qui n'est pas listé ci-dessus
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
