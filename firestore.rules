rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // UTILISATEURS
    // ═══════════════════════════════════════════════════════════════
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /selfie/{document} {
        allow read: if request.auth != null;
        allow create: if request.auth.uid == uid;
        allow write: if request.auth.uid == uid;
        allow delete: if request.auth.uid == uid;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // TWIN INVITATION (relation de match entre 2 utilisateurs)
    // Champ 'users' : liste de 2 UIDs (les deux twins matchés)
    // ═══════════════════════════════════════════════════════════════
    match /twinInvitation/{docId} {
      // Lecture : uniquement les deux utilisateurs concernés
      allow read: if request.auth != null
          && request.auth.uid in resource.data.users;

      // Création : l'initiateur doit être fromUid, dans users, statut 'pending'
      allow create: if request.auth != null
          && request.auth.uid == request.resource.data.fromUid
          && request.auth.uid in request.resource.data.users
          && request.resource.data.users.size() == 2
          && request.resource.data.status == 'pending';

      // Modification : l'un des deux peut changer le statut uniquement
      // valeurs autorisées : 'accepted' ou 'declined'
      allow update: if request.auth != null
          && request.auth.uid in resource.data.users
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SQUADS (champ 'users' aligné avec twinInvitation)
    // ═══════════════════════════════════════════════════════════════
    match /squads/{squadId} {
      // Lecture : uniquement les membres du squad
      allow read: if request.auth != null
          && request.auth.uid in resource.data.users;

      // Création : le créateur doit être dans users, seul au départ
      allow create: if request.auth != null
          && request.auth.uid == request.resource.data.createdBy
          && request.auth.uid in request.resource.data.users
          && request.resource.data.users.size() == 1;

      // Modification :
      // - Un membre existant peut modifier (renommer, quitter)
      // - Un non-membre peut s'ajouter via invitation acceptée
      //   à condition que seul le champ users change et que le squad ne soit pas plein
      allow update: if request.auth != null && (
          request.auth.uid in resource.data.users
          ||
          (!(request.auth.uid in resource.data.users)
           && request.auth.uid in request.resource.data.users
           && request.resource.data.users.size() == resource.data.users.size() + 1
           && request.resource.data.users.size() <= 5
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users']))
      );

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // INVITATIONS SQUAD
    // ═══════════════════════════════════════════════════════════════
    match /squad_invitations/{inviteId} {
      // Lecture : uniquement l'expéditeur ou le destinataire
      allow read: if request.auth != null
          && (request.auth.uid == resource.data.toUid
           || request.auth.uid == resource.data.fromUid);

      // Création : l'expéditeur doit être l'utilisateur connecté, statut forcé à 'pending'
      allow create: if request.auth != null
          && request.auth.uid == request.resource.data.fromUid
          && request.resource.data.status == 'pending';

      // Modification : uniquement le destinataire, uniquement le champ status
      allow update: if request.auth != null
          && request.auth.uid == resource.data.toUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SESSIONS DE ROUTINES (Twin & Squad)
    // ═══════════════════════════════════════════════════════════════
    match /squad_sessions/{sessionId} {
      // Lecture : uniquement les membres du squad concerné
      allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/squads/$(resource.data.squadId)).data.users;

      // Création : l'initiateur doit être l'utilisateur connecté
      allow create: if request.auth != null
          && request.auth.uid == request.resource.data.launchedBy;

      // Modification : seuls acceptedBy et status peuvent changer
      allow update: if request.auth != null
          && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['acceptedBy', 'status']);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // INVITATIONS DE ROUTINE (lien partageable avec code)
    // Permet d'inviter un contact externe ou non inscrit à rejoindre
    // une session de routine via un lien contenant un code unique.
    // ═══════════════════════════════════════════════════════════════
    match /routine_invitations/{code} {
      // Lecture : tout utilisateur connecté (valider un code à l'inscription)
      allow read: if request.auth != null;

      // Création : l'initiateur doit être l'utilisateur connecté
      allow create: if request.auth != null
          && request.auth.uid == request.resource.data.createdBy
          && request.resource.data.status == 'pending';

      // Modification : marquer le code comme utilisé (status + usedBy uniquement)
      allow update: if request.auth != null
          && resource.data.status == 'pending'
          && request.resource.data.status == 'used'
          && request.auth.uid == request.resource.data.usedBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedBy']);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SESSIONS DE ROUTINE TWIN
    // ═══════════════════════════════════════════════════════════════
    match /twin_sessions/{sessionId} {
      // Lecture : uniquement les deux utilisateurs de la session
      allow read: if request.auth != null
          && request.auth.uid in resource.data.users;

      // Création : le lanceur doit être l'utilisateur connecté et dans users[]
      allow create: if request.auth != null
          && request.auth.uid == request.resource.data.launchedBy
          && request.auth.uid in request.resource.data.users
          && request.resource.data.users.size() == 2;

      // Modification : les deux peuvent changer acceptedBy et status uniquement
      allow update: if request.auth != null
          && request.auth.uid in resource.data.users
          && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['acceptedBy', 'status']);

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // SQUAD (ancien système FlutterFlow — lecture seule en prod)
    // ═══════════════════════════════════════════════════════════════
    match /Squad/{squadId} {
      allow read: if request.auth != null;
      allow create, write, delete: if false;

      match /members/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    // TWIN SIGNALS
    // ═══════════════════════════════════════════════════════════════
    // Le document ID = UID de l'utilisateur — on vérifie directement le path
    match /twin_signals/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // PROFIL TWIN
    // ═══════════════════════════════════════════════════════════════
    match /profil_twin/{document} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
          && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // ROUTINES & TÂCHES
    // ═══════════════════════════════════════════════════════════════
    match /routine/{document} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.user_ref_path
          == /databases/$(database)/documents/users/$(request.auth.uid);
      allow update, delete: if resource.data.user_ref_path
          == /databases/$(database)/documents/users/$(request.auth.uid);
    }

    match /routine/{parent}/taches/{document} {
      allow read: if request.auth != null;
      allow create, write, delete: if request.auth != null;
    }

    match /{path=**}/taches/{document} {
      allow read: if request.auth != null;
    }

    // ═══════════════════════════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════════════════════════
    match /Notification/{document} {
      allow read: if request.auth != null
          && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null
          && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // CALENDRIER (FlutterFlow — auth requise)
    // ═══════════════════════════════════════════════════════════════
    match /calendar_events/{document} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /calendar_connections_events/{document} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /calendar_connections/{document} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /CalendarEvents/{document} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // HUME / GUARDIAN / ACTUALITÉ
    // ═══════════════════════════════════════════════════════════════
    match /hume_jobs/{document} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    match /GuardianActions/{document} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    match /guardian_suggestions/{document} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }

    match /Actualite/{document} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // CHALLENGES
    // ═══════════════════════════════════════════════════════════════
    match /challenge/{document} {
      allow create: if request.auth != null
          && /databases/$(database)/documents/users/$(request.auth.uid)
             in request.resource.data.user;
      allow read: if request.auth != null
          && /databases/$(database)/documents/users/$(request.auth.uid)
             in resource.data.user;
      allow update, delete: if request.auth != null
          && /databases/$(database)/documents/users/$(request.auth.uid)
             in resource.data.user;
    }

    // ═══════════════════════════════════════════════════════════════
    // REFUS PAR DÉFAUT — tout ce qui n'est pas listé ci-dessus
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
